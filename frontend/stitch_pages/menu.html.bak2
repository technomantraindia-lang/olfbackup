        </button>
        <div id="sub-stations" class="submenu-container hidden pl-6 pr-1 py-1 space-y-0.5">
          <a href="/stations" id="sublink-stations" class="submenu-link flex items-center gap-2 px-2 py-1 rounded text-[11px] transition-colors">
            <span class="w-1.5 h-1.5 rounded-full bg-current opacity-40"></span>
