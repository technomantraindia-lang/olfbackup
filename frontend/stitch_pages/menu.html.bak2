          <a href="/trains" id="sublink-trains" class="submenu-link flex items-center gap-2 px-2 py-1 rounded text-[11px] transition-colors">
            <span class="w-1.5 h-1.5 rounded-full bg-current opacity-40"></span>
            <span>Trains &amp; Routes</span>
