# PostgreSQL is required. MariaDB/MySQL cannot run this application's schemas.
NODE_ENV=production
ENVIRONMENT=production
SERVER_PORT=5004
BASE_URL=https://olf.technomantra.in
TRUST_PROXY=1
# Disable here when an existing backend already runs these scheduled tasks.
ENABLE_CRON=false
# Optional: absolute path; packaged releases also detect ./frontend automatically.
FRONTEND_DIR=
SQL_DB_HOST_IP=
SQL_DB_PORT=5432
USERS_DB_NAME=
SQL_DB_USER=
SQL_DB_PASSWORD=
SQL_DB_SSL=true
SQL_DB_SSL_REJECT_UNAUTHORIZED=true
# Generate a unique random secret; never reuse an example value.
SECRET_KEY=
# Optional integrations remain unconfigured until real credentials are supplied.
RAZORPAY_ID=
RAZORPAY_PASSWORD=
IRCTC_WEBHOOK_TOKEN=
IRCTC_WEBHOOK_AUTH_HEADER=x-olf-webhook-token
IRCTC_WEBHOOK_AUTH_SCHEME=
# Existing configured provider environment is preserved. Production needs its own credentials.
IRCTC_BASE_URL=https://stage-ecatering.ipsator.com
IRCTC_AUTH_TOKEN=
IRCTC_SECRET_KEY=
IRCTC_VENDOR_ID=
# Durable worker is independent of the legacy cron switch.
IRCTC_WORKER_ENABLED=true
ORDER_SMTP_EMAIL=
ORDER_SMTP_PASSWORD=
LOG_VERBOSE=false
LOG_REQUEST_PAYLOADS=false
